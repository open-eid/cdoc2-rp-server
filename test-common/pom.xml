            <version>3.2</version>
        </dependency>

        <dependency>
            <groupId>ee.sk.mid</groupId>
            <artifactId>mid-rest-java-client</artifactId>
            <version>1.7</version>
        </dependency>

        <dependency>
            <groupId>ee.cyber.cdoc2</groupId>
            <artifactId>cdoc2-rp-server-openapi</artifactId>
            <version>0.7.3</version>
            <scope>compile</scope>
        </dependency>

        <!-- This is mainly needed to allow maven-surefire-plugin excludedGroups to work -
         it requires JUnit engine on the classpath
         -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
        </dependency>
